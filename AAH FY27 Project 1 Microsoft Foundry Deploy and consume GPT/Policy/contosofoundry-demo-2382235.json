 
{
  "if": {
    "anyOf": [
      {
        "not": {
          "anyOf": [
            { "field": "type", "like": "Microsoft.CognitiveServices/accounts/*" },
            { "field": "type", "like": "Microsoft.CognitiveServices/accounts/projects/*" },
            { "field": "type", "like": "Microsoft.Resources/deployments/*" },
            { "field": "type", "like": "Microsoft.Resources/subscriptions/resourceGroups/*" },
            { "field": "type", "like": "Microsoft.Authorization/roleAssignments/*" },
            { "field": "type", "like": "Microsoft.Authorization/roleDefinitions/*" },
            {
              "field": "type",
              "in": [
                "Microsoft.CognitiveServices/accounts",
                "Microsoft.CognitiveServices/accounts/projects",
                "Microsoft.Resources/deployments",
                "Microsoft.Resources/subscriptions/resourceGroups",
                "Microsoft.Authorization/roleAssignments",
                "Microsoft.Authorization/roleDefinitions"
              ]
            }
          ]
        }
      }
    ]
  },
  "then": { "effect": "deny" }
}
 
